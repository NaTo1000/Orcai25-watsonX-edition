ORCAI_ALLOWED_HOSTS=naydoev1.example.com
ORCAI_FORWARDED_ALLOW_IPS=127.0.0.1
ORCAI_HUGGINGFACE_OWNER=NaTo10000
ORCAI_PUBLIC_TENANT_SLUG=naydoev1
ORCAI_MAX_MODEL_RUNNERS=2
ORCAI_RATE_LIMIT_PER_MINUTE=120

# Point these at root-owned, mode-0600 credential files when enabled.
ORCAI_SECURITY_SECRET_FILE=/etc/orcai25/credentials/security-secret
IONQ_API_KEY_FILE=/etc/orcai25/credentials/ionq-api-key
IBM_QUANTUM_API_KEY_FILE=/etc/orcai25/credentials/ibm-quantum-api-key

# Hardware target names must be copied from the provider account.
# No unverified backend alias is enabled by default.
ORCAI_IBM_NIGHTHAWK_TARGET=
IBM_QUANTUM_CRN=
IBM_QUANTUM_CHANNEL=ibm_cloud
ORCAI_IONQ_HARDWARE_TARGETS=
ORCAI_RIGETTI_QVM_TARGET=9q-square-qvm
ORCAI_RIGETTI_QPU_TARGET=
QCS_SETTINGS_FILE_PATH=/etc/orcai25/credentials/qcs-settings.toml
