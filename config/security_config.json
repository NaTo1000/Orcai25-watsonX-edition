{
  "security": {
    "zero_trust": {
      "enabled": true,
      "mfa_required_for_high_trust": true,
      "session_timeout_seconds": 3600,
      "continuous_verification_interval": 300,
      "behavioral_score_threshold": 0.3
    },
    "quantum_crypto": {
      "enabled": true,
      "algorithm": "ML-KEM-1024",
      "hash_algorithm": "SHA3-512",
      "key_rotation_interval": 86400
    },
    "encryption": {
      "enabled": true,
      "at_rest": "AES-256-GCM",
      "in_transit": "TLS 1.3",
      "quantum_resistant": true
    },
    "access_controls": {
      "enabled": true,
      "default_deny": true,
      "micro_segmentation": true,
      "least_privilege": true
    }
  },
  "monitoring": {
    "enabled": true,
    "real_time_alerts": true,
    "anomaly_detection": true,
    "baseline_samples": 100,
    "alert_thresholds": {
      "cpu_usage": 0.9,
      "memory_usage": 0.9,
      "failed_logins": 5,
      "api_errors": 100
    }
  },
  "audit": {
    "enabled": true,
    "audit_logging_enabled": true,
    "log_retention_days": 365,
    "tamper_proof": true,
    "compliance_checks": ["SOC2", "ISO27001", "GDPR", "HIPAA"]
  },
  "emergency_protocols": {
    "enabled": true,
    "rogue_ai_detection": true,
    "automatic_containment": true,
    "circuit_breaker_enabled": true,
    "emergency_contacts": [
      "security-team@example.com",
      "incident-response@example.com"
    ]
  },
  "threat_detection": {
    "enabled": true,
    "ai_behavior_analysis": true,
    "adversarial_detection": true,
    "prompt_injection_detection": true,
    "model_poisoning_detection": true,
    "threat_intelligence_feeds": true
  },
  "compliance": {
    "privacy_by_design": true,
    "breach_notification_enabled": true,
    "data_protection_impact_assessment": true,
    "user_management_enabled": true,
    "intrusion_detection_enabled": true
  },
  "communication": {
    "protocol": "Secure Envelope v1 over TLS 1.3",
    "security_level": "high",
    "perfect_forward_secrecy": true,
    "mutual_tls": false,
    "certificate_pinning": true
  },
  "system": {
    "environment": "production",
    "log_level": "INFO",
    "max_concurrent_sessions": 10000,
    "rate_limiting_enabled": true
  }
}
